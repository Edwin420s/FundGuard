APP_ENV=development
APP_NAME=Omega FundGuard
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./fundguard.db
# For Docker Compose use:
# DATABASE_URL=postgresql+psycopg://fundguard:fundguard_dev_only@db:5432/fundguard

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SETTLEMENT_MODE=simulated
ALLOW_STELLAR_TESTNET=false
ALLOW_STELLAR_MAINNET=false
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Do not place signing secrets in this file. Use a dedicated signer/secret manager for a real integration.
